# Spatius Direct Mode credentials.
# Copy this file to .env.local and fill real values before running `npm run dev`.
VITE_SPATIUS_APP_ID=your_spatius_app_id
VITE_SPATIUS_AVATAR_ID=your_spatius_avatar_id
VITE_SPATIUS_SESSION_TOKEN=your_spatius_session_token
VITE_SPATIUS_REGION=us-west

# LiveKit Agents integration for the dashboard ops avatar.
# Start the official token server / agent worker, then point the web app here.
VITE_LIVEKIT_TOKEN_ENDPOINT=http://127.0.0.1:8080/token
VITE_LIVEKIT_ROOM_NAME=cotriage-ops-watch
