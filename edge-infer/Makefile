MODULE := edge-infer IMAGE_PREFIX ?= cotriage-nova IMAGE_TAG ?= java25  .PHONY: build test image run build: 	cd .. && ./mvnw -B -ntp -pl $(MODULE) -am -DskipTests package test: 	cd .. && ./mvnw -B -ntp -pl $(MODULE) -am test image: 	cd .. && docker build -f $(MODULE)/Dockerfile -t $(IMAGE_PREFIX)/$(MODULE):$(IMAGE_TAG) . run: build 	java -Xms64m -Xmx256m -jar target/$(MODULE)-0.1.0-SNAPSHOT.jar
